rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile data: only accessible by the owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Habits & tracking data: only accessible by the owner
    match /habits/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
