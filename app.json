{
  "expo": {
    "name": "Onyx",
    "slug": "onyx-habit-tracker",
    "scheme": "onyx-habit-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/onyx-app-icon-1024x1024.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/onyx-app-icon-1024x1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.onyx.habittracker",
      "buildNumber": "1",
      "icon": "./assets/images/onyx-app-icon-1024x1024.png",
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires camera access to allow you to take a profile picture.",
        "NSPhotoLibraryUsageDescription": "This app requires access to your photo library to select a profile picture and save your streak achievements."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/onyx-app-icon-1024x1024.png",
        "backgroundColor": "#121212"
      },
      "package": "com.onyx.habittracker",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "icon": "./assets/images/onyx-app-icon-512x512.png"
    },
    "web": {
      "favicon": "./assets/images/onyx-app-icon-512x512.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-asset",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/onyx-app-icon-512x512.png",
          "color": "#6366F1"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9005956424727190~4380402516",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMultiDex": true,
            "kotlinVersion": "1.9.24",
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e90fd087-5b5b-483c-bd94-24fcd6eb44e3"
      }
    }
  }
}
