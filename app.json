{
  "expo": {
    "name": "Onyx",
    "slug": "onyx-habit-tracker",
    "scheme": "onyx-habit-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/onyx-app-icon-1024x1024.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.onyx.habittracker",
      "buildNumber": "1",
      "icon": "./assets/images/onyx-app-icon-1024x1024.png",
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires camera access to allow you to take a profile picture.",
        "NSPhotoLibraryUsageDescription": "This app requires access to your photo library to select a profile picture and save your streak achievements."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/onyx-app-icon-1024x1024.png",
        "backgroundColor": "#121212"
      },
      "package": "com.onyx.habittracker",
      "versionCode": 5,
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "icon": "./assets/images/onyx-app-icon-512x512.png",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/onyx-app-icon-512x512.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/onyx-splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#09090B"
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/onyx-app-icon-512x512.png",
          "color": "#6366F1"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9005956424727190~4380402516",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMultiDex": true,
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-web-browser",
      "./plugins/withReleaseSigning"
    ],
    "extra": {
      "eas": {
        "projectId": "e90fd087-5b5b-483c-bd94-24fcd6eb44e3"
      }
    }
  }
}
